{
  "name": "@qaiddev/quests-embed",
  "version": "1.0.1",
  "description": "Any Questions for your Users?",
  "type": "module",
  "main": "./dist/qaid-quests.umd.cjs",
  "module": "./dist/qaid-quests.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/qaid-quests.js",
      "require": "./dist/qaid-quests.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qaiddev/quests-embed.git"
  },
  "homepage": "https://github.com/qaiddev/quests-embed#readme",
  "bugs": {
    "url": "https://github.com/qaiddev/quests-embed/issues"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.5.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "quests",
    "questionnaire",
    "question",
    "answer",
    "feedback",
    "QA",
    "form",
    "survey",
    "embed",
    "qaid"
  ],
  "license": "MIT"
}
